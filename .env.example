PORT=3000
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/rachas

# Parte III — Firebase Admin (nunca commitear valores reales)

# Opción recomendada (Windows): JSON de la cuenta de servicio fuera del repo
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json

# Opción alternativa (si no usás FIREBASE_SERVICE_ACCOUNT_PATH):
# FIREBASE_PROJECT_ID=rachas-50813
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@rachas-50813.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Parte IV — versionado y política de app
MIN_APP_VERSION=1.0.0
RECOMMENDED_APP_VERSION=1.1.0
V1_SUNSET_DATE=2026-12-31
